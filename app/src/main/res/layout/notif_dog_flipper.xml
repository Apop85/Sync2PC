<?xml version="1.0" encoding="utf-8"?>
<!-- Laufender Hund - feste Quell-Assets (eingefroren seit SYNC-20261109-066), NICHT vom Build erzeugt.
     16 Bilder (Entscheid Inhaber: Bilder 1-16, Aussenlinie nachgezogen mit tools/refine-anim-outline.py), 42 ms je Bild (Tempo 100 %, = DogStatus.FRAME_MS).
     Benachrichtigungen koennen keine Videos/GIFs abspielen; ein ViewFlipper blaettert die Bilder durch
     und pausiert automatisch bei ausgeschaltetem Bildschirm. -->
<ViewFlipper xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:autoStart="true"
    android:flipInterval="42">
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:src="@drawable/anim_dog_01" />
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:src="@drawable/anim_dog_02" />
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:src="@drawable/anim_dog_03" />
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:src="@drawable/anim_dog_04" />
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:src="@drawable/anim_dog_05" />
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:src="@drawable/anim_dog_06" />
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:src="@drawable/anim_dog_07" />
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:src="@drawable/anim_dog_08" />
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:src="@drawable/anim_dog_09" />
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:src="@drawable/anim_dog_10" />
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:src="@drawable/anim_dog_11" />
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:src="@drawable/anim_dog_12" />
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:src="@drawable/anim_dog_13" />
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:src="@drawable/anim_dog_14" />
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:src="@drawable/anim_dog_15" />
