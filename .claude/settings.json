{
  "permissions": {
    "additionalDirectories": [
      "C:\\Users\\rbald\\AppData\\Local\\Temp"
    ],
    "deny": [
      "Edit(/coordination/tasks/**)",
      "Edit(/coordination/inbox/**)",
      "Edit(/coordination/TASK-INDEX.md)",
      "Edit(/coordination/.history/**)",
      "Edit(/coordination/.audit.log)",
