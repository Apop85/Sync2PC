            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "C:/Users/rbald/Documents/Sync2PC/tools/Auftrag-guard.ps1"],
            "timeout": 30
          }
        ]
      }
    ]
  }
}
